# Copy this file to .env and fill it in. Never commit the real .env.

FIRM_NAME=Your Firm Name
APP_URL=http://localhost:5000
SECRET_KEY=replace-with-a-long-random-string
ADMIN_PASSWORD=choose-an-admin-password
# Optional: a shared code the team types on the submission form
TEAM_ACCESS_CODE=

TIMEZONE=America/Chicago
REMINDER_HOUR=9
DEADLINE_HOUR=12

# AI scoring (get a key at console.anthropic.com). Without it, basic rules are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Email. Microsoft 365: smtp.office365.com, port 587. Gmail: smtp.gmail.com, port 587 with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: secret for /tasks/tick so an outside cron service can wake the app
CRON_KEY=
DATA_DIR=data
